$payload = $accessToken.Split('.')[1]

# Base64URL -> Base64
$payload = $payload.Replace('-', '+').Replace('_', '/')

switch ($payload.Length % 4) {
    2 { $payload += '==' }
    3 { $payload += '=' }
}

$tokenJson = [System.Text.Encoding]::UTF8.GetString(
    [Convert]::FromBase64String($payload)
)

$tokenJson | ConvertFrom-Json | Format-List *