={
  ooStatusCheckStatusCode: response.status,
  ooExecutionSummary: response.body[1],
  ooExecutionStatus: response.body[1].status,
  ooResultStatusType: response.body[1].resultStatusType,
  ooResultStatusName: response.body[1].resultStatusName
}


= ooExecutionStatus = "COMPLETED"
  and ooResultStatusType = "RESOLVED"


= ooExecutionStatus = "SYSTEM_FAILURE"
  or ooExecutionStatus = "CANCELED"
  or (
    ooExecutionStatus = "COMPLETED"
    and ooResultStatusType = "ERROR"
  )


= ooExecutionStatus = "RUNNING"
  or ooExecutionStatus = "PAUSED"
  or ooExecutionStatus = "PENDING_PAUSE"
  or ooExecutionStatus = "PENDING_CANCEL"

