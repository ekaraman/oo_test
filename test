<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OO_Camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="OO_Workflow_Process" name="OpenText OO Workflow Orchestration" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OO" name="Start">
      <bpmn:outgoing>Flow_Start_Lookup</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_OO_Lookup" name="OO Workflow Bul" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type"/>
          <zeebe:input source="=ooUsername" target="authentication.username"/>
          <zeebe:input source="=ooPassword" target="authentication.password"/>
          <zeebe:input source="GET" target="method"/>
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/flows/library&quot;" target="url"/>
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="false" target="storeResponse"/>
          <zeebe:input source="false" target="followRedirects"/>
          <zeebe:input source="20" target="connectionTimeoutInSeconds"/>
          <zeebe:input source="60" target="readTimeoutInSeconds"/>
          <zeebe:output source="=ooALLFlows[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = null or ooFlowPath = &quot;&quot; or item.path = ooFlowPath)]" target="ooFlowMatches"/>
          <zeebe:output source="=if count(ooALLFlows[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = null or ooFlowPath = &quot;&quot; or item.path = ooFlowPath)]) = 1 then ooALLFlows[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = null or ooFlowPath = &quot;&quot; or item.path = ooFlowPath)][1].id else null" target="ooFlowUuid"/>
          <zeebe:output source="=ooLookupStatusCode" target="ooLookupStatusCode"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15"/>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2"/>
          <zeebe:header key="resultExpression" value="={ooLookupStatusCode: response.status, ooALLFlows: response.body}"/>
          <zeebe:header key="retryBackoff" value="PT30S"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Lookup</bpmn:incoming>
      <bpmn:outgoing>Flow_Lookup_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OO_Found" name="Workflow Bulundu mu?" default="Flow_OO_NotFound">
      <bpmn:incoming>Flow_Lookup_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OO_Found</bpmn:outgoing>
      <bpmn:outgoing>Flow_OO_NotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Launch_Merge">
      <bpmn:incoming>Flow_OO_Found</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Launch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_OO_Launch" name="OO Workflow Başlat" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type"/>
          <zeebe:input source="=ooUsername" target="authentication.username"/>
          <zeebe:input source="=ooPassword" target="authentication.password"/>
          <zeebe:input source="POST" target="method"/>
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/executions&quot;" target="url"/>
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="={flowUuid: ooFlowUuid, runName: if ooRunName = null or ooRunName = &quot;&quot; then &quot;Camunda:&quot; + ooFlowName else ooRunName, inputs: if ooParametersJson = null or ooParametersJson = &quot;&quot; then {} else from json(ooParametersJson), inputPromptUseBlank: false}" target="body"/>
          <zeebe:input source="false" target="storeResponse"/>
          <zeebe:input source="false" target="followRedirects"/>
          <zeebe:input source="20" target="connectionTimeoutInSeconds"/>
          <zeebe:input source="60" target="readTimeoutInSeconds"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15"/>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2"/>
          <zeebe:header key="resultExpression" value="={ooLaunchStatusCode: response.status, ooExecutionId: response.body, ooStartedFlowUuid: ooFlowUuid}"/>
          <zeebe:header key="retryBackoff" value="PT30S"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_Launch</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_StatusMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Status_Merge">
      <bpmn:incoming>Flow_Launch_StatusMerge</bpmn:incoming>
      <bpmn:incoming>Flow_Status_Running</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusMerge_Timer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_OO_Wait" name="10 sn Bekle">
      <bpmn:incoming>Flow_StatusMerge_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Status</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_OO_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask_OO_Status" name="Workflow Durumunu Kontrol Et" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type"/>
          <zeebe:input source="=ooUsername" target="authentication.username"/>
          <zeebe:input source="=ooPassword" target="authentication.password"/>
          <zeebe:input source="GET" target="method"/>
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/executions/&quot; + string(ooExecutionId) + &quot;/summary&quot;" target="url"/>
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="false" target="storeResponse"/>
          <zeebe:input source="false" target="followRedirects"/>
          <zeebe:input source="20" target="connectionTimeoutInSeconds"/>
          <zeebe:input source="60" target="readTimeoutInSeconds"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15"/>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2"/>
          <zeebe:header key="resultExpression" value="={ooStatusCheckStatusCode: response.status, ooExecutionFullResult: response.body[1], ooExecutionStatus: response.body[1].status, ooResultStatusType: response.body[1].resultStatusType, ooResultStatusName: response.body[1].resultStatusName, ooExecutionSummary: response.body[1]}"/>
          <zeebe:header key="retryBackoff" value="PT30S"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OO_Status" name="Workflow Durumu" default="Flow_Status_Finished">
      <bpmn:incoming>Flow_Status_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Running</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Finished</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_OO_Output" name="OO Outputlarını Al" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3"/>
        <zeebe:ioMapping>
          <zeebe:input target="authentication.type" source="basic"/>
          <zeebe:input target="authentication.username" source="=ooUsername"/>
          <zeebe:input target="authentication.password" source="=ooPassword"/>
          <zeebe:input target="method" source="GET"/>
          <zeebe:input target="url" source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/executions/&quot; + string(ooExecutionId) + &quot;/execution-log&quot;"/>
          <zeebe:input target="headers" source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}"/>
          <zeebe:input target="storeResponse" source="false"/>
          <zeebe:input target="followRedirects" source="false"/>
          <zeebe:input target="connectionTimeoutInSeconds" source="20"/>
          <zeebe:input target="readTimeoutInSeconds" source="60"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15"/>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2"/>
          <zeebe:header key="resultExpression" value="={ooOutputStatusCode: response.status, ooFlowOutputs: if response.body.flowOutput = null then {} else response.body.flowOutput}"/>
          <zeebe:header key="retryBackoff" value="PT30S"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Status_Finished</bpmn:incoming>
      <bpmn:outgoing>Flow_Output_FinalResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OO_FinalResult" name="Workflow Sonucu" default="Flow_Final_Failed">
      <bpmn:incoming>Flow_Output_FinalResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Final_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OO_Success" name="Başarılı">
      <bpmn:incoming>Flow_Final_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_OO_Error" name="Hata Durumunda Karar Ver">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="oo-error-form"/>
        <zeebe:assignmentDefinition candidateGroups="automation-admins"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Final_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OO_ErrorAction" name="Ne yapılsın?" default="Flow_Continue">
      <bpmn:incoming>Flow_Error_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_Continue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OO_Continue" name="Manuel Devam Edildi">
      <bpmn:incoming>Flow_Continue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OO_NotFound" name="Workflow Bulunamadı / Belirsiz">
      <bpmn:incoming>Flow_OO_NotFound</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Lookup" sourceRef="StartEvent_OO" targetRef="ServiceTask_OO_Lookup"/>
    <bpmn:sequenceFlow id="Flow_Lookup_Gateway" sourceRef="ServiceTask_OO_Lookup" targetRef="Gateway_OO_Found"/>
    <bpmn:sequenceFlow id="Flow_OO_Found" name="Evet" sourceRef="Gateway_OO_Found" targetRef="Gateway_Launch_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooFlowUuid != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OO_NotFound" name="Hayır / Birden Fazla" sourceRef="Gateway_OO_Found" targetRef="End_OO_NotFound"/>
    <bpmn:sequenceFlow id="Flow_Merge_Launch" sourceRef="Gateway_Launch_Merge" targetRef="ServiceTask_OO_Launch"/>
    <bpmn:sequenceFlow id="Flow_Launch_StatusMerge" sourceRef="ServiceTask_OO_Launch" targetRef="Gateway_Status_Merge"/>
    <bpmn:sequenceFlow id="Flow_StatusMerge_Timer" sourceRef="Gateway_Status_Merge" targetRef="Timer_OO_Wait"/>
    <bpmn:sequenceFlow id="Flow_Timer_Status" sourceRef="Timer_OO_Wait" targetRef="ServiceTask_OO_Status"/>
    <bpmn:sequenceFlow id="Flow_Status_Gateway" sourceRef="ServiceTask_OO_Status" targetRef="Gateway_OO_Status"/>
    <bpmn:sequenceFlow id="Flow_Status_Running" name="Çalışıyor / Bekliyor" sourceRef="Gateway_OO_Status" targetRef="Gateway_Status_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooExecutionStatus = "RUNNING" or ooExecutionStatus = "PAUSED" or ooExecutionStatus = "PENDING_PAUSE" or ooExecutionStatus = "PENDING_CANCEL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Error_Decision" sourceRef="UserTask_OO_Error" targetRef="Gateway_OO_ErrorAction"/>
    <bpmn:sequenceFlow id="Flow_Retry_Merge" name="Tekrar Başlat" sourceRef="Gateway_OO_ErrorAction" targetRef="Gateway_Launch_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooErrorAction = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Continue" name="Devam Et" sourceRef="Gateway_OO_ErrorAction" targetRef="End_OO_Continue"/>
    <bpmn:sequenceFlow id="Flow_Status_Finished" sourceRef="Gateway_OO_Status" targetRef="ServiceTask_OO_Output" name="Bitti"/>
    <bpmn:sequenceFlow id="Flow_Output_FinalResult" sourceRef="ServiceTask_OO_Output" targetRef="Gateway_OO_FinalResult"/>
    <bpmn:sequenceFlow id="Flow_Final_Success" sourceRef="Gateway_OO_FinalResult" targetRef="End_OO_Success" name="Başarılı">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooExecutionStatus = "COMPLETED" and ooResultStatusType = "RESOLVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Final_Failed" sourceRef="Gateway_OO_FinalResult" targetRef="UserTask_OO_Error" name="Başarısız"/>
  </bpmn:process>
