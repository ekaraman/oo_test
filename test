$camundaUrl = "https://CAMUNDA-API"

# Process definition'ları getir
$body = @{
    page = @{
        limit = 100
    }
} | ConvertTo-Json -Depth 5

$result = Invoke-RestMethod `
    -Method Post `
    -Uri "$camundaUrl/v2/process-definitions/search" `
    -Headers $headers `
    -ContentType "application/json" `
    -Body $body

$result.items | Select-Object `
    processDefinitionKey,
    processDefinitionId,
    name,
    version