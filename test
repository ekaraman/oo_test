
# ==========================================
# 1. CONFIGURATION
# ==========================================

$baseUrl = "https://camunda-operate.qnb.com.tr"
$tokenUrl = "https://camunda-auth.qnb.com.tr/auth/realms/camunda-platform/protocol/openid-connect/token"

$clientId = "jira-camunda-user"
$clientSecret = "YOUR_CLIENT_SECRET"
$username = "YOUR_USERNAME"
$password = "YOUR_PASSWORD"

$processId = "JiraTaskAutomation"
$versionTag = "tst"  # tst veya prd

# ==========================================
# 2. GET ACCESS TOKEN
# ==========================================

$body = @{
    grant_type    = "password"
    client_id     = $clientId
    client_secret = $clientSecret
    username      = $username
    password      = $password
}

$response = Invoke-RestMethod `
    -Method Post `
    -Uri $tokenUrl `
    -ContentType "application/x-www-form-urlencoded" `
    -Body $body

$token = $response.access_token

$headers = @{
    Authorization = "Bearer $token"
}

# ==========================================
# 3. FIND PROCESS BY VERSION TAG
# ==========================================

$searchBody = @{
    filter = @{
        processDefinitionId = $processId
        versionTag = $versionTag
    }
    sort = @(
        @{
            field = "version"
            order = "DESC"
        }
    )
    page = @{
        limit = 100
    }
} | ConvertTo-Json -Depth 10

$definitions = Invoke-RestMethod `
    -Method Post `
    -Uri "$baseUrl/v2/process-definitions/search" `
    -Headers $headers `
    -ContentType "application/json" `
    -Body $searchBody

$selected = $definitions.items |
    Sort-Object version -Descending |
    Select-Object -First 1

if (-not $selected) {
    throw "Process bulunamadi: $processId / $versionTag"
}

Write-Host "Process ID: $processId"
Write-Host "Version Tag: $versionTag"
Write-Host "Zeebe Version: $($selected.version)"
Write-Host "Definition Key: $($selected.processDefinitionKey)"

# ==========================================
# 4. START PROCESS INSTANCE
# ==========================================

$processBody = @{
    processDefinitionKey = [string]$selected.processDefinitionKey

    variables = @{
        jiraTaskCategoryId = "IJSD-4436100"
        jiraIssueKey = "CHG-58159"
    }
} | ConvertTo-Json -Depth 10

$result = Invoke-RestMethod `
    -Method Post `
    -Uri "$baseUrl/v2/process-instances" `
    -Headers $headers `
    -ContentType "application/json" `
    -Body $processBody

# ==========================================
# 5. RESULT
# ==========================================

Write-Host "Process started successfully!"
Write-Host "Process Instance Key: $($result.processInstanceKey)"





### groovy




import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.HttpURLConnection

def baseUrl = "https://camunda-operate.qnb.com.tr"
def token = "ACCESS_TOKEN_FROM_KEYCLOAK"

def processId = "JiraTaskAutomation"
def versionTag = "prd"

// HTTP POST helper
def postJson = { String path, Map payload ->
    def conn = (HttpURLConnection)
        new URL(baseUrl + path).openConnection()

    conn.requestMethod = "POST"
    conn.doOutput = true
    conn.setRequestProperty(
        "Authorization", "Bearer ${token}")
    conn.setRequestProperty(
        "Content-Type", "application/json")

    conn.outputStream.withWriter("UTF-8") {
        it.write(JsonOutput.toJson(payload))
    }

    def status = conn.responseCode
    def stream = status < 400 ?
        conn.inputStream : conn.errorStream
    def response = stream?.getText("UTF-8")

    conn.disconnect()

    if (status >= 400) {
        throw new RuntimeException(
            "Camunda HTTP ${status}: ${response}")
    }

    return new JsonSlurper().parseText(response)
}

// 1. Find process definition
def definitions = postJson(
    "/v2/process-definitions/search",
    [
        filter: [
            processDefinitionId: processId,
            versionTag: versionTag
        ],
        sort: [[field: "version", order: "DESC"]],
        page: [limit: 100]
    ]
)

def selected = definitions.items
    .max { it.version as Integer }

if (!selected) {
    throw new RuntimeException(
        "Process not found: ${processId}/${versionTag}")
}

// 2. Start process instance
def result = postJson(
    "/v2/process-instances",
    [
        processDefinitionKey:
            selected.processDefinitionKey.toString(),
        variables: [
            jiraTaskCategoryId: "IJSD-4436100",
            jiraIssueKey: "CHG-58159"
        ]
    ]
)

log.info("Started: ${result.processInstanceKey}")
