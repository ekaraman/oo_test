else if ooExecutionStatus != "COMPLETED"
     or ooResultStatusType != "RESOLVED"
then bpmnError(
  "REST_GENERAL_ERROR",
  "OO workflow execution failed",
  {
    errorCode: "OO_EXECUTION_ERROR",
    errorMessage: "OO status kontrolü başarısız.",
    debugExecutionStatus: ooExecutionStatus,
    debugResultStatusType: ooResultStatusType
  }
)