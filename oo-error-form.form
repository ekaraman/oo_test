{
  "components": [
    {
      "text": "# OO workflow başarısız tamamlandı\n\nWorkflow yeniden başlatılabilir veya süreç manuel olarak devam ettirilebilir. Operate üzerinden `ooExecutionId` ve `ooExecutionStatus` değişkenlerini kontrol edebilirsin.",
      "type": "text",
      "layout": { "row": "Row_1", "columns": 16 },
      "id": "Text_ErrorInfo"
    },
    {
      "values": [
        { "label": "Tekrar Başlat", "value": "retry" },
        { "label": "Devam Et", "value": "continue" }
      ],
      "label": "Ne yapılsın?",
      "type": "radio",
      "layout": { "row": "Row_2", "columns": 16 },
      "id": "Field_ooErrorAction",
      "key": "ooErrorAction",
      "defaultValue": "retry",
      "validate": { "required": true }
    }
  ],
  "type": "default",
  "id": "oo-error-form",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
