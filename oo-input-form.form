{
  "components": [
    {
      "label": "OO URL (host:port, https:// olmadan)",
      "type": "textfield",
      "layout": { "row": "Row_1", "columns": 16 },
      "id": "Field_ooUrl",
      "key": "ooUrl",
      "defaultValue": "XXXX",
      "validate": { "required": true }
    },
    {
      "label": "OO Kullanıcı Adı",
      "type": "textfield",
      "layout": { "row": "Row_2", "columns": 8 },
      "id": "Field_ooUsername",
      "key": "ooUsername",
      "validate": { "required": true }
    },
    {
      "label": "OO Şifre",
      "type": "textfield",
      "subtype": "password",
      "layout": { "row": "Row_2", "columns": 8 },
      "id": "Field_ooPassword",
      "key": "ooPassword",
      "validate": { "required": true }
    },
    {
      "label": "OO Workflow Adı",
      "type": "textfield",
      "layout": { "row": "Row_3", "columns": 16 },
      "id": "Field_ooFlowName",
      "key": "ooFlowName",
      "description": "OO Flow Library içindeki workflow adı. Aynı isimden birden fazla varsa aşağıdaki tam path alanını doldur.",
      "validate": { "required": true }
    },
    {
      "label": "OO Workflow Path (opsiyonel)",
      "type": "textfield",
      "layout": { "row": "Row_4", "columns": 16 },
      "id": "Field_ooFlowPath",
      "key": "ooFlowPath",
      "defaultValue": "",
      "description": "Örnek: Library/Automation/MyFlow.xml. Workflow adı tekil ise boş bırakılabilir."
    },
    {
      "label": "Run Name (opsiyonel)",
      "type": "textfield",
      "layout": { "row": "Row_5", "columns": 16 },
      "id": "Field_ooRunName",
      "key": "ooRunName",
      "defaultValue": "",
      "description": "Boş bırakılırsa Camunda:<workflow adı> kullanılır."
    },
    {
      "label": "Parameters (JSON)",
      "type": "textarea",
      "layout": { "row": "Row_6", "columns": 16 },
      "id": "Field_ooParametersJson",
      "key": "ooParametersJson",
      "defaultValue": "{}",
      "description": "Ansible playbook'taki inputs.Parameters alanına gönderilecek JSON metni. Örnek: {\"ServerName\":\"srv01\",\"Action\":\"start\"}",
      "validate": { "required": true }
    }
  ],
  "type": "default",
  "id": "oo-input-form",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}
