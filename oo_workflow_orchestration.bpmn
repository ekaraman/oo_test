<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
  id="Definitions_OO_Camunda"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.39.0"
  modeler:executionPlatform="Camunda Cloud"
  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="OO_Workflow_Process" name="OpenText OO Workflow Orchestration" isExecutable="true">

    <bpmn:startEvent id="StartEvent_OO" name="Start">
      <bpmn:outgoing>Flow_Start_Input</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_OO_Input" name="OO Bilgilerini Gir">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="oo-input-form" />
        <zeebe:assignmentDefinition candidateGroups="automation-admins" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Input_Lookup</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_OO_Lookup" name="OO Workflow Bul" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="=ooUsername" target="authentication.username" />
          <zeebe:input source="=ooPassword" target="authentication.password" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/flows/library&quot;" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="60" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ooLookupStatusCode: response.status, ooFlowMatches: response.body[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = &quot;&quot; or item.path = ooFlowPath)], ooFlowUuid: if count(response.body[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = &quot;&quot; or item.path = ooFlowPath)]) = 1 then response.body[item.leaf = true and item.runnable = true and item.name = ooFlowName and (ooFlowPath = &quot;&quot; or item.path = ooFlowPath)][1].id else null}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Input_Lookup</bpmn:incoming>
      <bpmn:outgoing>Flow_Lookup_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OO_Found" name="Workflow Bulundu mu?" default="Flow_OO_NotFound">
      <bpmn:incoming>Flow_Lookup_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OO_Found</bpmn:outgoing>
      <bpmn:outgoing>Flow_OO_NotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Launch_Merge">
      <bpmn:incoming>Flow_OO_Found</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Launch</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_OO_Launch" name="OO Workflow Başlat" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="=ooUsername" target="authentication.username" />
          <zeebe:input source="=ooPassword" target="authentication.password" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/executions&quot;" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="={flowUuid: ooFlowUuid, runName: if ooRunName = null or ooRunName = &quot;&quot; then &quot;Camunda:&quot; + ooFlowName else ooRunName, logLevel: &quot;STANDARD&quot;, inputs: {Parameters: ooParametersJson}}" target="body" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="60" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ooLaunchStatusCode: response.status, ooExecutionId: response.body, ooStartedFlowUuid: ooFlowUuid}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_Launch</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_StatusMerge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Status_Merge">
      <bpmn:incoming>Flow_Launch_StatusMerge</bpmn:incoming>
      <bpmn:incoming>Flow_Running_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusMerge_Timer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="Timer_OO_Wait" name="30 sn Bekle">
      <bpmn:incoming>Flow_StatusMerge_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Status</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_OO_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="ServiceTask_OO_Status" name="Workflow Durumunu Kontrol Et" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="=ooUsername" target="authentication.username" />
          <zeebe:input source="=ooPassword" target="authentication.password" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&quot;https://&quot; + ooUrl + &quot;/oo/rest/v2/executions/&quot; + string(ooExecutionId) + &quot;/summary&quot;" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Accept&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="60" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ooStatusHttpCode: response.status, ooExecutionSummary: response.body[1], ooExecutionStatus: response.body[1].status}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OO_Status" name="Workflow Durumu" default="Flow_Status_Failed">
      <bpmn:incoming>Flow_Status_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Running</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_OO_Success" name="Başarılı">
      <bpmn:incoming>Flow_Status_Success</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_OO_Error" name="Hata Durumunda Karar Ver">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="oo-error-form" />
        <zeebe:assignmentDefinition candidateGroups="automation-admins" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Status_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_OO_ErrorAction" name="Ne yapılsın?" default="Flow_Continue">
      <bpmn:incoming>Flow_Error_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_Continue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_OO_Continue" name="Manuel Devam Edildi">
      <bpmn:incoming>Flow_Continue</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_OO_NotFound" name="Workflow Bulunamadı / Belirsiz">
      <bpmn:incoming>Flow_OO_NotFound</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Input" sourceRef="StartEvent_OO" targetRef="UserTask_OO_Input" />
    <bpmn:sequenceFlow id="Flow_Input_Lookup" sourceRef="UserTask_OO_Input" targetRef="ServiceTask_OO_Lookup" />
    <bpmn:sequenceFlow id="Flow_Lookup_Gateway" sourceRef="ServiceTask_OO_Lookup" targetRef="Gateway_OO_Found" />
    <bpmn:sequenceFlow id="Flow_OO_Found" name="Evet" sourceRef="Gateway_OO_Found" targetRef="Gateway_Launch_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooFlowUuid != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OO_NotFound" name="Hayır / Birden Fazla" sourceRef="Gateway_OO_Found" targetRef="End_OO_NotFound" />
    <bpmn:sequenceFlow id="Flow_Merge_Launch" sourceRef="Gateway_Launch_Merge" targetRef="ServiceTask_OO_Launch" />
    <bpmn:sequenceFlow id="Flow_Launch_StatusMerge" sourceRef="ServiceTask_OO_Launch" targetRef="Gateway_Status_Merge" />
    <bpmn:sequenceFlow id="Flow_StatusMerge_Timer" sourceRef="Gateway_Status_Merge" targetRef="Timer_OO_Wait" />
    <bpmn:sequenceFlow id="Flow_Timer_Status" sourceRef="Timer_OO_Wait" targetRef="ServiceTask_OO_Status" />
    <bpmn:sequenceFlow id="Flow_Status_Gateway" sourceRef="ServiceTask_OO_Status" targetRef="Gateway_OO_Status" />
    <bpmn:sequenceFlow id="Flow_Status_Running" name="Çalışıyor / Bekliyor" sourceRef="Gateway_OO_Status" targetRef="Gateway_Status_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(ooExecutionStatus = "COMPLETED" or ooExecutionStatus = "FAILED" or ooExecutionStatus = "CANCELED" or ooExecutionStatus = "SYSTEM_FAILURE" or starts with(ooExecutionStatus, "COMPLETED_"))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Success" name="Başarılı" sourceRef="Gateway_OO_Status" targetRef="End_OO_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooExecutionStatus = "COMPLETED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Failed" name="Başarısız" sourceRef="Gateway_OO_Status" targetRef="UserTask_OO_Error" />
    <bpmn:sequenceFlow id="Flow_Error_Decision" sourceRef="UserTask_OO_Error" targetRef="Gateway_OO_ErrorAction" />
    <bpmn:sequenceFlow id="Flow_Retry_Merge" name="Tekrar Başlat" sourceRef="Gateway_OO_ErrorAction" targetRef="Gateway_Launch_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ooErrorAction = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Continue" name="Devam Et" sourceRef="Gateway_OO_ErrorAction" targetRef="End_OO_Continue" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_OO">
    <bpmndi:BPMNPlane id="BPMNPlane_OO" bpmnElement="OO_Workflow_Process">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_OO"><dc:Bounds x="140" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Input" bpmnElement="UserTask_OO_Input"><dc:Bounds x="220" y="190" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lookup" bpmnElement="ServiceTask_OO_Lookup"><dc:Bounds x="400" y="190" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Found" bpmnElement="Gateway_OO_Found" isMarkerVisible="true"><dc:Bounds x="610" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LaunchMerge" bpmnElement="Gateway_Launch_Merge" isMarkerVisible="true"><dc:Bounds x="720" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Launch" bpmnElement="ServiceTask_OO_Launch"><dc:Bounds x="820" y="190" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StatusMerge" bpmnElement="Gateway_Status_Merge" isMarkerVisible="true"><dc:Bounds x="1020" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer" bpmnElement="Timer_OO_Wait"><dc:Bounds x="1120" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1092" y="258" width="92" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Status" bpmnElement="ServiceTask_OO_Status"><dc:Bounds x="1210" y="190" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StatusGateway" bpmnElement="Gateway_OO_Status" isMarkerVisible="true"><dc:Bounds x="1440" y="205" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1426" y="175" width="78" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Success" bpmnElement="End_OO_Success"><dc:Bounds x="1580" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1575" y="258" width="48" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ErrorTask" bpmnElement="UserTask_OO_Error"><dc:Bounds x="1390" y="360" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ErrorGateway" bpmnElement="Gateway_OO_ErrorAction" isMarkerVisible="true"><dc:Bounds x="1170" y="375" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1158" y="435" width="74" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Continue" bpmnElement="End_OO_Continue"><dc:Bounds x="1010" y="382" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="970" y="428" width="116" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NotFound" bpmnElement="End_OO_NotFound"><dc:Bounds x="617" y="360" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="570" y="406" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Start_Input" bpmnElement="Flow_Start_Input"><di:waypoint x="176" y="230" /><di:waypoint x="220" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Input_Lookup" bpmnElement="Flow_Input_Lookup"><di:waypoint x="350" y="230" /><di:waypoint x="400" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Lookup_Gateway" bpmnElement="Flow_Lookup_Gateway"><di:waypoint x="550" y="230" /><di:waypoint x="610" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_OO_Found" bpmnElement="Flow_OO_Found"><di:waypoint x="660" y="230" /><di:waypoint x="720" y="230" /><bpmndi:BPMNLabel><dc:Bounds x="682" y="210" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_OO_NotFound" bpmnElement="Flow_OO_NotFound"><di:waypoint x="635" y="255" /><di:waypoint x="635" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="645" y="295" width="118" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Merge_Launch" bpmnElement="Flow_Merge_Launch"><di:waypoint x="770" y="230" /><di:waypoint x="820" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Launch_StatusMerge" bpmnElement="Flow_Launch_StatusMerge"><di:waypoint x="970" y="230" /><di:waypoint x="1020" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_StatusMerge_Timer" bpmnElement="Flow_StatusMerge_Timer"><di:waypoint x="1070" y="230" /><di:waypoint x="1120" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Timer_Status" bpmnElement="Flow_Timer_Status"><di:waypoint x="1156" y="230" /><di:waypoint x="1210" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Status_Gateway" bpmnElement="Flow_Status_Gateway"><di:waypoint x="1380" y="230" /><di:waypoint x="1440" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Status_Success" bpmnElement="Flow_Status_Success"><di:waypoint x="1490" y="230" /><di:waypoint x="1580" y="230" /><bpmndi:BPMNLabel><dc:Bounds x="1518" y="210" width="42" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Status_Failed" bpmnElement="Flow_Status_Failed"><di:waypoint x="1465" y="255" /><di:waypoint x="1465" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="1475" y="300" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Status_Running" bpmnElement="Flow_Status_Running"><di:waypoint x="1465" y="205" /><di:waypoint x="1465" y="120" /><di:waypoint x="1045" y="120" /><di:waypoint x="1045" y="205" /><bpmndi:BPMNLabel><dc:Bounds x="1225" y="100" width="108" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Error_Decision" bpmnElement="Flow_Error_Decision"><di:waypoint x="1390" y="400" /><di:waypoint x="1220" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Retry_Merge" bpmnElement="Flow_Retry_Merge"><di:waypoint x="1195" y="375" /><di:waypoint x="1195" y="320" /><di:waypoint x="745" y="320" /><di:waypoint x="745" y="255" /><bpmndi:BPMNLabel><dc:Bounds x="925" y="300" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Continue" bpmnElement="Flow_Continue"><di:waypoint x="1170" y="400" /><di:waypoint x="1046" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="1090" y="380" width="54" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
