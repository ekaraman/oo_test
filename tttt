=if list contains(serverName, "ALL")
then
  ["ALL"]
else
  concatenate(
    ["ALL"],
    sort(
      distinct values(
        if list contains(restartType, "ALL")
        then
          KOSParameters[
            item.ortam = environment
          ].Servername
        else
          KOSParameters[
            item.ortam = environment
            and list contains(restartType, item.RestartType)
          ].Servername
      ),
      function(x, y) x < y
    )
  )


=if list contains(serviceName, "ALL")
then
  ["ALL"]
else
  concatenate(
    ["ALL"],
    sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
          and
          (
            list contains(restartType, "ALL")
            or list contains(restartType, item.RestartType)
          )
          and
          (
            list contains(serverName, "ALL")
            or list contains(serverName, item.Servername)
          )
        ].ServiceName
      ),
      function(x, y) x < y
    )
  )