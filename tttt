=if environment = null
then
  []
else if restartType != null
  and list contains(
    for r in restartType
    return split(r, "[|]")[-1],
    "ALL"
  )
then
  [
    {
      label: "ALL",
      value: environment + "|ALL"
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value: environment + "|ALL"
      }
    ],
    for r in sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
        ].RestartType
      ),
      function(x, y) x < y
    )
    return {
      label: r,
      value: environment + "|" + r
    }
  )





