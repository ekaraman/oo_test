=if restartType != null
  and list contains(restartType, environment + "|ALL")
then
  [
    {
      label: "ALL",
      value: environment + "|ALL"
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value: environment + "|ALL"
      }
    ],
    for r in sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
        ].RestartType
      ),
      function(x, y) x < y
    )
    return {
      label: r,
      value: environment + "|" + r
    }
  )







=if restartType = null
then
  []
else if count(restartType) = 0
then
  []
else if serverName != null
  and list contains(
    serverName,
    environment + "|" +
    string join(
      sort(restartType, function(x, y) x < y),
      ","
    ) +
    "|ALL"
  )
then
  [
    {
      label: "ALL",
      value:
        environment + "|" +
        string join(
          sort(restartType, function(x, y) x < y),
          ","
        ) +
        "|ALL"
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value:
          environment + "|" +
          string join(
            sort(restartType, function(x, y) x < y),
            ","
          ) +
          "|ALL"
      }
    ],
    for s in sort(
      distinct values(
        if list contains(restartType, environment + "|ALL")
        then
          KOSParameters[
            item.ortam = environment
          ].Servername
        else
          KOSParameters[
            item.ortam = environment
            and list contains(
              restartType,
              environment + "|" + item.RestartType
            )
          ].Servername
      ),
      function(x, y) x < y
    )
    return {
      label: s,
      value:
        environment + "|" +
        string join(
          sort(restartType, function(x, y) x < y),
          ","
        ) +
        "|" + s
    }
  )







=if restartType = null
then
  []
else if count(restartType) = 0
then
  []
else if serverName = null
then
  []
else if count(serverName) = 0
then
  []
else if serviceName != null
  and list contains(
    serviceName,
    environment + "|" +
    string join(
      sort(restartType, function(x, y) x < y),
      ","
    ) +
    "|" +
    string join(
      sort(serverName, function(x, y) x < y),
      ","
    ) +
    "|ALL"
  )
then
  [
    {
      label: "ALL",
      value:
        environment + "|" +
        string join(
          sort(restartType, function(x, y) x < y),
          ","
        ) +
        "|" +
        string join(
          sort(serverName, function(x, y) x < y),
          ","
        ) +
        "|ALL"
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value:
          environment + "|" +
          string join(
            sort(restartType, function(x, y) x < y),
            ","
          ) +
          "|" +
          string join(
            sort(serverName, function(x, y) x < y),
            ","
          ) +
          "|ALL"
      }
    ],
    for s in sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
          and
          (
            list contains(restartType, environment + "|ALL")
            or
            list contains(
              restartType,
              environment + "|" + item.RestartType
            )
          )
          and
          (
            list contains(
              serverName,
              environment + "|" +
              string join(
                sort(restartType, function(x, y) x < y),
                ","
              ) +
              "|ALL"
            )
            or
            list contains(
              serverName,
              environment + "|" +
              string join(
                sort(restartType, function(x, y) x < y),
                ","
              ) +
              "|" + item.Servername
            )
          )
        ].ServiceName
      ),
      function(x, y) x < y
    )
    return {
      label: s,
      value:
        environment + "|" +
        string join(
          sort(restartType, function(x, y) x < y),
          ","
        ) +
        "|" +
        string join(
          sort(serverName, function(x, y) x < y),
          ","
        ) +
        "|" + s
    }
  )

