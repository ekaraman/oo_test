
=to json({
  ServerName:
    string join(
      distinct values(selectedKOSRows.Servername),
      ";"
    ),

  ServiceName:
    string join(
      for s in distinct values(selectedKOSRows.Servername)
      return
        string join(
          distinct values(
            selectedKOSRows[Servername = s].ServiceName
          ),
          ","
        ),
      ";"
    )
})
