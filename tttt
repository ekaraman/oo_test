
# ==========================================
# CAMUNDA DRC - ONAY SURELERI RAPORU
# Keycloak Token + Camunda API + CSV
# ==========================================

$ErrorActionPreference = "Stop"

# ==========================================
# 1. BAGLANTI BILGILERI
# ==========================================

$TokenUrl = Read-Host "Keycloak Token URL"

$ApiBase = Read-Host "Camunda API adresi"

$ClientId = Read-Host "Client ID"

$ClientSecretSecure = Read-Host "Client Secret" -AsSecureString

$ProcessInstanceKey = "2251799817545821"

# ==========================================
# 2. KEYCLOAK ACCESS TOKEN AL
# ==========================================

Write-Host ""
Write-Host "Keycloak token aliniyor..." -ForegroundColor Cyan

$bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR(
    $ClientSecretSecure
)

try {
    $ClientSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR(
        $bstr
    )
}
finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
}

try {

    $tokenBody = @{
        grant_type    = "client_credentials"
        client_id     = $ClientId
        client_secret = $ClientSecret
    }

    $tokenResponse = Invoke-RestMethod `
        -Uri $TokenUrl `
        -Method Post `
        -ContentType "application/x-www-form-urlencoded" `
        -Body $tokenBody

    $AccessToken = $tokenResponse.access_token

    if ([string]::IsNullOrWhiteSpace($AccessToken)) {
        throw "Token yanitinda access_token bulunamadi."
    }

    Write-Host "Token basariyla alindi." -ForegroundColor Green

}
catch {
    Write-Host "Token alma hatasi: $($_.Exception.Message)" -ForegroundColor Red
    return
}
finally {
    $ClientSecret = $null
    $ClientSecretSecure = $null
    $tokenBody = $null
}

# ==========================================
# 3. CAMUNDA API BAGLANTISI
# ==========================================

$ApiUrl = $ApiBase.TrimEnd('/') + "/v2/element-instances/search"

$headers = @{
    Authorization = "Bearer $AccessToken"
    Accept        = "application/json"
}

Write-Host ""
Write-Host "Camunda onay kayitlari getiriliyor..." -ForegroundColor Cyan

# ==========================================
# 4. TUM USER TASK KAYITLARINI GETIR
# ==========================================

$allTasks = @()

$offset = 0
$limit = 500

try {

    do {

        $body = @{
            filter = @{
                processInstanceKey = $ProcessInstanceKey
                type = "USER_TASK"
            }

            sort = @(
                @{
                    field = "elementInstanceKey"
                    order = "ASC"
                }
            )

            page = @{
                from  = $offset
                limit = $limit
            }

        } | ConvertTo-Json -Depth 10

        $response = Invoke-RestMethod `
            -Uri $ApiUrl `
            -Method Post `
            -Headers $headers `
            -ContentType "application/json" `
            -Body $body

        $tasks = @(
            $response.items | Where-Object {
                $null -ne $_
            }
        )

        $allTasks += $tasks

        $offset += $tasks.Count

        Write-Host "Alinan kayit sayisi: $($allTasks.Count)"

    } while ($tasks.Count -eq $limit)

}
catch {

    Write-Host ""
    Write-Host "Camunda API hatasi: $($_.Exception.Message)" -ForegroundColor Red

    return

}
finally {
    $AccessToken = $null
    $headers = $null
    $tokenResponse = $null
}

# ==========================================
# 5. ONAY SURELERINI HESAPLA
# ==========================================

$now = [DateTimeOffset]::UtcNow

$report = @(

    foreach ($task in $allTasks) {

        if (-not $task.startDate) {
            Write-Warning "Baslangic tarihi olmayan kayit atlandi."
            continue
        }

        $start = [DateTimeOffset]::Parse($task.startDate)

        if ($task.endDate) {

            $end = [DateTimeOffset]::Parse($task.endDate)

        }
        else {

            $end = $now

        }

        $duration = $end - $start

        $taskName = $task.elementName

        if ([string]::IsNullOrWhiteSpace($taskName)) {
            $taskName = $task.elementId
        }

        [PSCustomObject]@{

            OnayAdi = $taskName

            Baslangic = $start.ToLocalTime().ToString(
                "yyyy-MM-dd HH:mm:ss"
            )

            Bitis = if ($task.endDate) {
                $end.ToLocalTime().ToString(
                    "yyyy-MM-dd HH:mm:ss"
                )
            }
            else {
                ""
            }

            SureDakika = [math]::Round(
                $duration.TotalMinutes, 2
            )

            SureSaat = [math]::Round(
                $duration.TotalHours, 2
            )

            Durum = $task.state

            ElementInstanceKey = $task.elementInstanceKey

        }

    }

)

# ==========================================
# 6. RAPORU SIRALA VE GOSTER
# ==========================================

$report = @($report | Sort-Object Baslangic)

Write-Host ""
Write-Host "========== DRC ONAY RAPORU ==========" -ForegroundColor Cyan

$report |
    Format-Table OnayAdi, Baslangic, Bitis, SureDakika, Durum -AutoSize

# ==========================================
# 7. CSV DOSYASI OLUSTUR
# ==========================================

$csvPath = Join-Path $PSScriptRoot "DRC_Onay_Sureleri.csv"

$report |
    Export-Csv `
        -Path $csvPath `
        -NoTypeInformation `
        -Delimiter ";" `
        -Encoding UTF8

Write-Host ""
Write-Host "Toplam onay kaydi: $($report.Count)" -ForegroundColor Green
Write-Host "CSV raporu: $csvPath" -ForegroundColor Green
