ServerParameters: to json({
  ServerName: string join(
    sort(
      distinct values(selectedKOSRows.Servername),
      function(x, y) x < y
    ),
    ";"
  ),
  ServiceNames: string join(
    for s in sort(
      distinct values(selectedKOSRows.Servername),
      function(x, y) x < y
    )
    return string join(
      sort(
        distinct values(
          selectedKOSRows[
            item.Servername = s
          ].ServiceName
        ),
        function(x, y) x < y
      ),
      ","
    ),
    ";"
  )
}),