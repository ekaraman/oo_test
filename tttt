=if restartType = null
then
  []
else if count(restartType) = 0
then
  []
else if serverName != null
  and list contains(
    serverName,
    environment
    + "|"
    + string join(
        sort(
          for r in restartType
          return split(r, "[|]")[-1],
          function(x, y) x < y
        ),
        ","
      )
    + "|ALL"
  )
then
  [
    {
      label: "ALL",
      value:
        environment
        + "|"
        + string join(
            sort(
              for r in restartType
              return split(r, "[|]")[-1],
              function(x, y) x < y
            ),
            ","
          )
        + "|ALL"
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value:
          environment
          + "|"
          + string join(
              sort(
                for r in restartType
                return split(r, "[|]")[-1],
                function(x, y) x < y
              ),
              ","
            )
          + "|ALL"
      }
    ],
    for s in sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
          and
          (
            list contains(
              for r in restartType
              return split(r, "[|]")[-1],
              "ALL"
            )
            or
            list contains(
              for r in restartType
              return split(r, "[|]")[-1],
              item.RestartType
            )
          )
        ].Servername
      ),
      function(x, y) x < y
    )
    return {
      label: s,
      value:
        environment
        + "|"
        + string join(
            sort(
              for r in restartType
              return split(r, "[|]")[-1],
              function(x, y) x < y
            ),
            ","
          )
        + "|"
        + s
    }
  )






