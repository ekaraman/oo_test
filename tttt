= if serverName = null
then
  []
else if
  serviceName != null
  and
  list contains(
    for r in restartType
    return split(r, "[|]")[-1],
    "ALL"
  )
  and
  list contains(
    for s in serverName
    return split(s, "[|]")[-1],
    "ALL"
  )
  and
  list contains(
    for s in serviceName
    return split(s, "[|]")[-1],
    "ALL"
  )
then
  sort(
    distinct values(
      for k in KOSParameters[
        item.ortam = environment
      ]
      return k.serverName
    )
  )
else
  for s in serverName
  return split(s, "[|]")[-1]





