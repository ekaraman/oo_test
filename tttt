=if restartType != null
   and list contains(restartType, "ALL|" + environment)
then
  [
    {
      label: "ALL",
      value: "ALL|" + environment
    }
  ]
else
  concatenate(
    [
      {
        label: "ALL",
        value: "ALL|" + environment
      }
    ],
    for r in sort(
      distinct values(
        KOSParameters[
          item.ortam = environment
        ].RestartType
      ),
      function(x, y) x < y
    )
    return {
      label: r,
      value: r
    }
  )