
& {

$ErrorActionPreference = "Stop"

# ==========================================
# 1. SABIT BILGILER
# ==========================================

$TokenUrl = "https://camunda-auth.qnb.com.tr/auth/realms/camunda-platform/protocol/openid-connect/token"

$ApiBase = "https://camunda-operate.qnb.com.tr"

$ClientId = "jira-camunda"

$ProcessKey = "2251799817545821"

$ApiUrl = "$ApiBase/v2/element-instances/search"

$CsvPath = Join-Path -Path (Get-Location).Path -ChildPath "DRC_Onay_Sureleri.csv"

$tr = [System.Globalization.CultureInfo]::GetCultureInfo("tr-TR")

$headers = $null

try {

    # ======================================
    # 2. KEYCLOAK TOKEN
    # ======================================

    Write-Host ""
    Write-Host "=== KEYCLOAK TOKEN ===" -ForegroundColor Cyan

    $secureSecret = Read-Host "Client Secret" -AsSecureString

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureSecret)

    try {

        $plainSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)

        $tokenBody = @{
            grant_type    = "client_credentials"
            client_id     = $ClientId
            client_secret = $plainSecret
        }

        $tokenResponse = Invoke-RestMethod `
            -Uri $TokenUrl `
            -Method POST `
            -ContentType "application/x-www-form-urlencoded" `
            -Body $tokenBody

        $accessToken = $tokenResponse.access_token

    }
    finally {

        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)

        $plainSecret = $null
        $secureSecret = $null
        $tokenBody = $null

    }

    if (-not $accessToken) {
        throw "Access token alinamadi."
    }

    $headers = @{
        Authorization = "Bearer $accessToken"
        Accept        = "application/json"
    }

    $accessToken = $null
    $tokenResponse = $null

    Write-Host "Token basariyla alindi." -ForegroundColor Green

    # ======================================
    # 3. PROCESS KONTROL
    # ======================================

    Write-Host ""
    Write-Host "=== PROCESS KONTROL ===" -ForegroundColor Cyan

    $process = Invoke-RestMethod `
        -Uri "$ApiBase/v2/process-instances/$ProcessKey" `
        -Method GET `
        -Headers $headers

    Write-Host "Process bulundu."
    Write-Host "Durum: $($process.state)"
    Write-Host "Baslangic: $($process.startDate)"

    # ======================================
    # 4. ELEMENT KAYITLARI
    # UTF-8 HAM VERI OKUMA
    # ======================================

    Write-Host ""
    Write-Host "=== ELEMENT KAYITLARI ===" -ForegroundColor Cyan

    $allElements = @()

    $offset = 0
    $limit = 500

    do {

        $body = @{
            filter = @{
                processInstanceKey = $ProcessKey
            }

            sort = @(
                @{
                    field = "elementInstanceKey"
                    order = "ASC"
                }
            )

            page = @{
                from  = $offset
                limit = $limit
            }

        } | ConvertTo-Json -Depth 10

        # JSON istegini UTF-8 byte olarak gonder
        $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes($body)

        # Ham HTTP yanitini al
        $webResponse = Invoke-WebRequest `
            -Uri $ApiUrl `
            -Method POST `
            -Headers $headers `
            -ContentType "application/json; charset=utf-8" `
            -Body $bodyBytes `
            -UseBasicParsing

        # Ham yanit byte'larini oku
        $memoryStream = New-Object System.IO.MemoryStream

        try {

            $rawStream = $webResponse.RawContentStream

            $rawStream.Position = 0

            $rawStream.CopyTo($memoryStream)

            $rawBytes = $memoryStream.ToArray()

        }
        finally {

            $memoryStream.Dispose()

        }

        # JSON'u acikca UTF-8 olarak decode et
        $jsonText = [System.Text.Encoding]::UTF8.GetString($rawBytes)

        $response = $jsonText | ConvertFrom-Json

        if ($null -eq $response.items) {
            Write-Warning "API yanitinda kayit bulunamadi."
            break
        }

        $items = @(
            $response.items | Where-Object {
                $null -ne $_
            }
        )

        $allElements += $items

        $offset += $items.Count

        Write-Host "Alinan element: $($allElements.Count)"

    } while ($items.Count -eq $limit)

    # ======================================
    # 5. USER TASK FILTRESI
    # ======================================

    $tasks = @(
        $allElements | Where-Object {
            $_.type -eq "USER_TASK"
        }
    )

    Write-Host ""
    Write-Host "Toplam onay kaydi: $($tasks.Count)" -ForegroundColor Green

    if ($tasks.Count -eq 0) {
        Write-Warning "Onay kaydi bulunamadi."
        return
    }

    # ======================================
    # 6. SURE HESAPLAMA
    # ======================================

    $now = [DateTimeOffset]::UtcNow

    $report = @(

        foreach ($task in $tasks) {

            if (-not $task.startDate) {
                continue
            }

            $start = [DateTimeOffset]::Parse(
                [string]$task.startDate
            )

            if ($task.endDate) {

                $end = [DateTimeOffset]::Parse(
                    [string]$task.endDate
                )

                $endText = $end.ToLocalTime().ToString(
                    "yyyy-MM-dd HH:mm:ss"
                )

                $sureTipi = "Tamamlandi"

            }
            elseif ($task.state -eq "COMPLETED") {

                Write-Warning "Tamamlanan gorevin bitis tarihi eksik: $($task.elementId)"
                continue

            }
            else {

                $end = $now
                $endText = ""
                $sureTipi = "Devam ediyor"

            }

            $duration = $end - $start

            $taskName = $task.elementName

            if ([string]::IsNullOrWhiteSpace($taskName)) {
                $taskName = $task.elementId
            }

            [PSCustomObject]@{

                OnayAdi = $taskName

                Baslangic = $start.ToLocalTime().ToString(
                    "yyyy-MM-dd HH:mm:ss"
                )

                Bitis = $endText

                # Turkce ondalik ayirici kullan
                SureDakika = $duration.TotalMinutes.ToString(
                    "0.00", $tr
                )

                SureSaat = $duration.TotalHours.ToString(
                    "0.00", $tr
                )

                Durum = $task.state

                SureTipi = $sureTipi

                ElementType = $task.type

                ElementId = $task.elementId

                ElementInstanceKey = $task.elementInstanceKey

            }

        }

    )

    # ======================================
    # 7. RAPOR
    # ======================================

    $report = @($report | Sort-Object Baslangic)

    Write-Host ""
    Write-Host "=== DRC ONAY RAPORU ===" -ForegroundColor Cyan

    Write-Host "Kayit sayisi: $($report.Count)"

    $report |
        Select-Object OnayAdi, SureDakika, Durum |
        Format-Table -AutoSize

    # ======================================
    # 8. CSV UTF-8 BOM
    # ======================================

    $csvLines = @(
        $report |
            ConvertTo-Csv `
                -NoTypeInformation `
                -Delimiter ";"
    )

    # Excel icin UTF-8 BOM ile kaydet
    $utf8Bom = New-Object System.Text.UTF8Encoding($true)

    [System.IO.File]::WriteAllLines(
        $CsvPath,
        [string[]]$csvLines,
        $utf8Bom
    )

    Write-Host ""
    Write-Host "RAPOR BASARIYLA OLUSTURULDU!" -ForegroundColor Green

    Write-Host "Kayit sayisi: $($report.Count)"

    Write-Host "Dosya: $CsvPath" -ForegroundColor Green

}
catch {

    Write-Host ""
    Write-Host "HATA: $($_.Exception.Message)" -ForegroundColor Red

}
finally {

    if ($null -ne $headers) {
        $headers.Authorization = $null
    }

    $accessToken = $null

}

}
