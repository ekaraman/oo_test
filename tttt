
& {

$ErrorActionPreference = "Stop"

# ==========================================
# 1. SABIT BILGILER
# ==========================================

$TokenUrl = "https://camunda-auth.qnb.com.tr/auth/realms/camunda-platform/protocol/openid-connect/token"

$ApiBase = "https://camunda-operate.qnb.com.tr"

$ClientId = "jira-camunda"

$ProcessKey = "2251799817545821"

$ApiUrl = "$ApiBase/v2/element-instances/search"

$CsvPath = Join-Path -Path (Get-Location).Path -ChildPath "DRC_Onay_Sureleri.csv"

$headers = $null

try {

    # ======================================
    # 2. KEYCLOAK TOKEN
    # ======================================

    Write-Host ""
    Write-Host "=== KEYCLOAK TOKEN ===" -ForegroundColor Cyan

    $secureSecret = Read-Host "Client Secret" -AsSecureString

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureSecret)

    try {
        $clientSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)

        $tokenBody = @{
            grant_type    = "client_credentials"
            client_id     = $ClientId
            client_secret = $clientSecret
        }

        $tokenResponse = Invoke-RestMethod `
            -Uri $TokenUrl `
            -Method POST `
            -ContentType "application/x-www-form-urlencoded" `
            -Body $tokenBody

    }
    finally {
        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        $clientSecret = $null
        $secureSecret = $null
        $tokenBody = $null
    }

    $accessToken = $tokenResponse.access_token

    if (-not $accessToken) {
        throw "Access token alinamadi."
    }

    $tokenResponse = $null

    Write-Host "Token basariyla alindi." -ForegroundColor Green

    $headers = @{
        Authorization = "Bearer $accessToken"
        Accept        = "application/json"
    }

    $accessToken = $null

    # ======================================
    # 3. PROCESS INSTANCE KONTROLU
    # ======================================

    Write-Host ""
    Write-Host "=== PROCESS KONTROL ===" -ForegroundColor Cyan

    $process = $null

    try {

        $process = Invoke-RestMethod `
            -Uri "$ApiBase/v2/process-instances/$ProcessKey" `
            -Method GET `
            -Headers $headers

        Write-Host "Process bulundu!" -ForegroundColor Green

        Write-Host "Key: $($process.processInstanceKey)"
        Write-Host "Durum: $($process.state)"
        Write-Host "Baslangic: $($process.startDate)"
        Write-Host "Bitis: $($process.endDate)"

    }
    catch {

        Write-Warning "Process sorgusu basarisiz: $($_.Exception.Message)"

    }

    # ======================================
    # 4. ELEMENT KAYITLARINI GETIR
    # ======================================

    Write-Host ""
    Write-Host "=== ELEMENT KAYITLARI ===" -ForegroundColor Cyan

    $allElements = @()

    $offset = 0
    $limit = 500
    $totalItems = $null

    do {

        $body = @{
            filter = @{
                processInstanceKey = $ProcessKey
            }

            sort = @(
                @{
                    field = "elementInstanceKey"
                    order = "ASC"
                }
            )

            page = @{
                from  = $offset
                limit = $limit
            }

        } | ConvertTo-Json -Depth 10

        $response = Invoke-RestMethod `
            -Uri $ApiUrl `
            -Method POST `
            -Headers $headers `
            -ContentType "application/json" `
            -Body $body

        if ($null -eq $response -or
            $null -eq $response.PSObject.Properties["items"]) {

            throw "Beklenmeyen API yaniti. items alani bulunamadi."
        }

        $totalItems = $response.page.totalItems

        $items = @(
            $response.items | Where-Object {
                $null -ne $_
            }
        )

        $allElements += $items

        $offset += $items.Count

        Write-Host "Alinan element: $($allElements.Count)"

    } while ($items.Count -eq $limit)

    Write-Host "API toplam kayit: $totalItems"

    # ======================================
    # 5. SIFIR KAYIT KONTROLU
    # ======================================

    if ($allElements.Count -eq 0) {

        Write-Host ""
        Write-Host "=== TANI BILGILERI ===" -ForegroundColor Yellow

        Write-Host "Element kaydi bulunamadi."
        Write-Host "Process Key: $ProcessKey"
        Write-Host "API: $ApiUrl"

        Write-Host ""
        Write-Host "Yanit alanlari:"

        $response.PSObject.Properties.Name

        Write-Host ""
        Write-Host "Sayfalama:"

        $response.page | ConvertTo-Json -Depth 5

        Write-Host ""
        Write-Warning "Process key, API erisim yetkisi ve veri gorunurlugu kontrol edilmeli."

        return
    }

    # ======================================
    # 6. ELEMENT TURLERINI GOSTER
    # ======================================

    Write-Host ""
    Write-Host "=== ELEMENT TURLERI ===" -ForegroundColor Cyan

    $allElements |
        Group-Object type |
        Select-Object Name, Count |
        Format-Table -AutoSize

    # ======================================
    # 7. ONAY ADIMLARINI SEC
    # ======================================

    $tasks = @(
        $allElements | Where-Object {
            $_.type -in @(
                "USER_TASK",
                "MANUAL_TASK",
                "TASK"
            )
        }
    )

    Write-Host ""
    Write-Host "Bulunan gorev sayisi: $($tasks.Count)" -ForegroundColor Green

    if ($tasks.Count -eq 0) {

        Write-Warning "Gorev tipi bulunamadi."

        $allElements |
            Select-Object -First 15 elementName, elementId, type, state |
            Format-Table -AutoSize

        return
    }

    # ======================================
    # 8. SURELERI HESAPLA
    # ======================================

    $now = [DateTimeOffset]::UtcNow

    $report = @(

        foreach ($task in $tasks) {

            if (-not $task.startDate) {
                Write-Warning "Baslangic tarihi yok: $($task.elementId)"
                continue
            }

            $start = [DateTimeOffset]::Parse([string]$task.startDate)

            if ($task.endDate) {

                $end = [DateTimeOffset]::Parse([string]$task.endDate)

                $endText = $end.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")

                $sureTipi = "Kesin"

            }
            else {

                $end = $now
                $endText = ""

                $sureTipi = "Devam ediyor"
            }

            $duration = $end - $start

            $taskName = $task.elementName

            if ([string]::IsNullOrWhiteSpace($taskName)) {
                $taskName = $task.elementId
            }

            [PSCustomObject]@{

                OnayAdi = $taskName

                Baslangic = $start.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")

                Bitis = $endText

                SureDakika = [math]::Round($duration.TotalMinutes, 2)

                SureSaat = [math]::Round($duration.TotalHours, 2)

                Durum = $task.state

                SureTipi = $sureTipi

                ElementType = $task.type

                ElementId = $task.elementId

                ElementInstanceKey = $task.elementInstanceKey
            }
        }
    )

    # ======================================
    # 9. RAPORU GOSTER
    # ======================================

    $report = @($report | Sort-Object Baslangic)

    if ($report.Count -eq 0) {
        Write-Warning "Raporlanabilecek kayit bulunamadi."
        return
    }

    Write-Host ""
    Write-Host "=== DRC ONAY RAPORU ===" -ForegroundColor Cyan

    $report |
        Format-Table OnayAdi, Baslangic, Bitis, SureDakika, Durum -AutoSize

    # ======================================
    # 10. TOPLAM DRC SURESI
    # ======================================

    if ($null -ne $process -and $process.startDate) {

        $processStart = [DateTimeOffset]::Parse([string]$process.startDate)

        if ($process.endDate) {
            $processEnd = [DateTimeOffset]::Parse([string]$process.endDate)
        }
        else {
            $processEnd = $now
        }

        $totalDuration = $processEnd - $processStart

        Write-Host ""
        Write-Host "=== TOPLAM DRC SURESI ===" -ForegroundColor Cyan

        Write-Host "Dakika: $([math]::Round($totalDuration.TotalMinutes,2))"

        Write-Host "Saat: $([math]::Round($totalDuration.TotalHours,2))"

        if (-not $process.endDate) {
            Write-Host "Process halen devam ediyor." -ForegroundColor Yellow
        }
    }

    # ======================================
    # 11. CSV RAPORU
    # ======================================

    $report |
        Export-Csv `
            -Path $CsvPath `
            -NoTypeInformation `
            -Delimiter ";" `
            -Encoding UTF8

    Write-Host ""
    Write-Host "RAPOR BASARIYLA OLUSTURULDU!" -ForegroundColor Green

    Write-Host "Toplam onay: $($report.Count)"

    Write-Host "CSV: $CsvPath" -ForegroundColor Green

}
catch {

    Write-Host ""
    Write-Host "HATA: $($_.Exception.Message)" -ForegroundColor Red

}
finally {

    if ($null -ne $headers) {
        $headers.Authorization = $null
    }

    $accessToken = $null

}

}
