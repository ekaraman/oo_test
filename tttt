$body = @{
    grant_type    = "password"
    client_id     = "jira-camunda-user"
    client_secret = "<CLIENT_SECRET>"
    username      = "<LDAP_USERNAME>"
    password      = "<LDAP_PASSWORD>"
}

$response = Invoke-RestMethod `
    -Method POST `
    -Uri "https://camunda-keycloak.seip-vip-prd-ocpgen10.qnb.com.tr/auth/realms/camunda-platform/protocol/openid-connect/token" `
    -ContentType "application/x-www-form-urlencoded" `
    -Body $body

$token = $response.access_token