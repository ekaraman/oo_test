
=concatenate(
  ["ALL"],
  sort(
    distinct values(
      if list contains(restartType, "ALL")
      then
        KOSParameters[
          item.ortam = environment
        ].Servername
      else
        KOSParameters[
          item.ortam = environment
          and list contains(restartType, item.RestartType)
        ].Servername
    ),
    function(x, y) x < y
  )
)


=concatenate(
  ["ALL"],
  sort(
    distinct values(
      KOSParameters[
        ortam = environment
        and (
          list contains(restartType, "ALL")
          or list contains(restartType, RestartType)
        )
        and (
          list contains(serverName, "ALL")
          or list contains(serverName, Servername)
        )
      ].ServiceName
    ),
    function(x, y) x < y
  )
)