=KOSParameters[
  item.ortam = environment
  and
  (
    list contains(
      for r in restartType
      return split(r, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for r in restartType
      return split(r, "[|]")[-1],
      item.RestartType
    )
  )
  and
  (
    list contains(
      for s in serverName
      return split(s, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for s in serverName
      return split(s, "[|]")[-1],
      item.Servername
    )
  )
  and
  (
    list contains(
      for s in serviceName
      return split(s, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for s in serviceName
      return split(s, "[|]")[-1],
      item.ServiceName
    )
  )
]