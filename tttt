
# ==========================================
# CAMUNDA DRC - ONAY SURELERI RAPORU
# ==========================================

# 1. Camunda API adresi
# Ornek: https://camunda-api.sirket.com
# Adresin sonuna /v2 EKLEMEYIN.

$ApiBase = Read-Host "Camunda API adresi"

# 2. Process Instance Key
$ProcessInstanceKey = "2251799817545821"

# 3. Access token
$secureToken = Read-Host "Access Token" -AsSecureString

$bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureToken)

try {
    $token = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
}
finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
}

# 4. API ayarlari
$uri = $ApiBase.TrimEnd('/') + "/v2/element-instances/search"

$headers = @{
    Authorization = "Bearer $token"
    Accept        = "application/json"
}

# 5. Butun onay kayitlarini getir
$allTasks = @()
$offset = 0
$limit = 500

try {

    do {

        $body = @{
            filter = @{
                processInstanceKey = $ProcessInstanceKey
                type = "USER_TASK"
            }

            sort = @(
                @{
                    field = "elementInstanceKey"
                    order = "ASC"
                }
            )

            page = @{
                from  = $offset
                limit = $limit
            }

        } | ConvertTo-Json -Depth 10

        $response = Invoke-RestMethod `
            -Uri $uri `
            -Method Post `
            -Headers $headers `
            -ContentType "application/json" `
            -Body $body `
            -ErrorAction Stop

        $tasks = @($response.items | Where-Object { $null -ne $_ })

        $allTasks += $tasks

        $offset += $tasks.Count

    } while ($tasks.Count -eq $limit)

}
catch {
    Write-Host "API hatasi: $($_.Exception.Message)" -ForegroundColor Red
    return
}
finally {
    $token = $null
    $headers.Authorization = $null
}

# 6. Sure hesaplama
$now = [DateTimeOffset]::UtcNow

$report = @(
    foreach ($task in $allTasks) {

        $start = [DateTimeOffset]::Parse($task.startDate)

        if ($task.endDate) {
            $end = [DateTimeOffset]::Parse($task.endDate)
        }
        else {
            $end = $now
        }

        $duration = $end - $start

        $taskName = $task.elementName

        if ([string]::IsNullOrWhiteSpace($taskName)) {
            $taskName = $task.elementId
        }

        [PSCustomObject]@{

            OnayAdi = $taskName

            Baslangic = $start.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")

            Bitis = if ($task.endDate) {
                $end.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            }
            else {
                ""
            }

            SureDakika = [math]::Round(
                $duration.TotalMinutes, 2
            )

            SureSaat = [math]::Round(
                $duration.TotalHours, 2
            )

            Durum = $task.state

            ElementInstanceKey = $task.elementInstanceKey
        }
    }
)

# 7. Baslangic saatine gore sirala
$report = @($report | Sort-Object Baslangic)

# 8. Ekranda goster
$report |
    Format-Table OnayAdi, Baslangic, Bitis, SureDakika, Durum -AutoSize

# 9. CSV raporu olustur
$csvPath = Join-Path $PWD.Path "DRC_Onay_Sureleri.csv"

$report |
    Export-Csv `
        -Path $csvPath `
        -NoTypeInformation `
        -Delimiter ";" `
        -Encoding UTF8

Write-Host ""
Write-Host "Toplam onay kaydi: $($report.Count)" -ForegroundColor Green
Write-Host "Rapor: $csvPath" -ForegroundColor Green
