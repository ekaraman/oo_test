=KOSParameters[
  item.ortam = selectedEnvironment
  and
  (
    list contains(
      for r in selectedRestartType
      return split(r, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for r in selectedRestartType
      return split(r, "[|]")[-1],
      item.RestartType
    )
  )
  and
  (
    list contains(
      for s in selectedServerName
      return split(s, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for s in selectedServerName
      return split(s, "[|]")[-1],
      item.Servername
    )
  )
  and
  (
    list contains(
      for s in selectedServiceName
      return split(s, "[|]")[-1],
      "ALL"
    )
    or
    list contains(
      for s in selectedServiceName
      return split(s, "[|]")[-1],
      item.ServiceName
    )
  )
]